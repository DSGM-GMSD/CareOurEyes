// Estado que la interfaz comparte con Rust. Rust rellena las propiedades y
// atiende los callbacks; la interfaz solo dibuja.

export struct MonitorItem {
    id: string,
    name: string,
    width: int,
    height: int,
    primary: bool,
}

export global App {
    // Navegación: 0 Pantalla, 1 Pausa, 2 Enfoque, 3 Prisma, 4 Opciones, 5 Acerca de.
    in-out property <int> page: 0;
    // Pestañas de Opciones: 0 General, 1 Temporizador, 2 Pantalla, 3 Atajos, 4 Reglas.
    in-out property <int> option-tab: 0;

    in property <bool> active: true;
    in property <string> engine: "Windows (GDI gamma)";
    in property <string> version: "";

    // --- Pantalla
    in property <[MonitorItem]> monitors;
    in property <int> selected: 0;
    in property <bool> supports-gamma: true;
    // Perfil en el orden de la cuadrícula: Lectura, Edición, Juego, Película,
    // Salud visual, Oficina, Personalizado, Pausa.
    in property <int> mode: 4;
    in property <float> brightness: 90;
    in property <int> kelvin: 5000;
    // Lo que de verdad está aplicado ahora (para el confort visual).
    in property <float> live-brightness: 100;
    in property <int> live-kelvin: 6500;
    in property <float> brightness-min: 20;
    in property <int> kelvin-min: 1500;
    in property <int> kelvin-max: 6500;
    in-out property <bool> editing-night: false;
    // Vista previa del periodo que no toca ahora (la pantalla ya lo muestra).
    in property <bool> previewing: false;
    in property <string> preview-text: "";
    callback end-preview();
    in property <bool> schedule-on: true;
    in property <string> schedule-range: "";
    // «Una regla está aplicando …» (vacío si no hay regla activa).
    in property <string> rule-notice: "";

    // Pide a Rust que vuelva a rellenar los valores (p. ej. al cambiar Día/Noche).
    callback refresh();
    callback select-monitor(int);
    callback refresh-monitors();
    // Empezar a arrastrar la ventana (fuera de Windows).
    callback start-drag();
    callback set-mode(int);
    callback set-brightness(float);
    callback set-kelvin(float);
    callback step-brightness(int);
    callback step-kelvin(int);
    callback slider-released();
    callback reset-monitor();
    // Diálogo «¿Restablecer …?» y nombre del perfil activo para su título.
    in-out property <bool> confirm-reset: false;
    in property <string> mode-name: "";
    callback set-schedule(bool);

    // --- Diálogo «Auto Día/Noche · Ajustes»
    in-out property <bool> dialog-open: false;
    in-out property <bool> d-use-location: true;
    in-out property <string> d-lat: "";
    in-out property <string> d-lon: "";
    in property <string> d-sunrise: "--:--";
    in property <string> d-sunset: "--:--";
    in-out property <int> d-day-h: 7;
    in-out property <int> d-day-m: 0;
    in-out property <int> d-night-h: 19;
    in-out property <int> d-night-m: 0;
    in-out property <bool> d-smooth: true;
    // Duración de la transición día ↔ noche, en minutos (pasos de 15).
    in-out property <int> d-minutes: 45;
    // 0 inactivo, 1 buscando, 2 falló
    in property <int> d-lookup: 0;
    callback open-dialog();
    callback coords-edited();
    callback detect-location();
    callback save-dialog();

    // --- Opciones
    in property <int> theme-mode: 0;
    in property <[string]> language-names;
    in property <int> language: 0;
    in property <bool> language-restart: false;
    in property <bool> check-updates: false;
    in property <string> update-text: "";
    in property <bool> update-available: false;
    in property <bool> checking: false;
    in property <bool> autostart: false;
    in property <bool> smooth: true;
    in property <bool> standard-gamma: false;
    in property <bool> wider-kelvin: false;
    in property <bool> wider-brightness: false;
    in property <bool> sync-monitors: false;
    in property <bool> close-to-tray: true;
    in property <bool> start-in-tray: false;
    in property <bool> reset-on-exit: true;

    callback set-theme-mode(int);
    callback set-accent(int);
    callback set-language(int);
    callback set-option(string, bool);
    callback check-now();
    callback download-update();
    callback open-issues();
    callback open-config-folder();
    callback open-repo();

    // --- Ventana
    // Diagnóstico (COE_DEBUG): eventos del ratón que llegan a la ventana.
    in property <bool> debug: false;
    callback debug-pointer(string, length, length);

    callback minimize();
    callback close();
}
