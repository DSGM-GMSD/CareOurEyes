// Piezas reutilizables (equivalen a Widgets.kt de la versión Kotlin).

import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";

// Icono vectorial de 24×24 escalado al tamaño pedido.
export component Icon inherits Path {
    in property <length> size: 16px;
    in property <color> tint: Theme.s400;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: tint;
    stroke-width: 0px;
}

// Logotipo: disco oscuro con el ojo blanco.
export component EyeMark {
    in property <length> size: 36px;
    width: size;
    height: size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 25.4;
        viewbox-height: 25.4;
        commands: Icons.logo-disc;
        fill: #101010;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 25.4;
        viewbox-height: 25.4;
        commands: Icons.logo-eye;
        fill: #ffffff;
    }
}

// Cuadro redondeado con un icono en el centro.
export component IconBox inherits Rectangle {
    in property <string> icon;
    in property <length> size: 36px;
    in property <color> tint: Theme.e450;
    in property <color> fill: Theme.o700;
    in property <color> line: Theme.border-soft;
    in property <length> radius: 12px;
    width: size;
    height: size;
    border-radius: radius;
    background: fill;
    border-width: 1px;
    border-color: line;
    Icon {
        commands: root.icon;
        size: root.size * 0.45;
        tint: root.tint;
    }
}

// Tarjeta base: obsidiana, borde tenue, esquinas de 16 px.
export component CareCard inherits Rectangle {
    in property <length> pad: 20px;
    in property <length> gap: 12px;
    background: Theme.o800;
    border-radius: Theme.card-radius;
    border-width: 1px;
    border-color: Theme.border-soft;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.card-shadow;
    VerticalLayout {
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

// Botón discreto con el texto en color de acento («Restablecer», «Ajustes»).
export component CareButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: ta.has-hover ? Theme.o700 : Theme.o700.with-alpha(0.7);
    border-width: 1px;
    border-color: ta.has-hover ? Theme.e450.with-alpha(0.35) : Theme.border-mid;
    opacity: enabled ? 1 : 0.5;
    animate border-color { duration: 150ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 14px;
            tint: Theme.e400;
        }
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: Theme.e400;
            vertical-alignment: center;
        }
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Botón cuadrado de − / + junto a las lecturas.
export component StepButton inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: Theme.dark ? (ta.has-hover ? Theme.o600 : Theme.o700) : (ta.has-hover ? Theme.o750 : Theme.o800);
    border-width: 1px;
    border-color: ta.has-hover && !Theme.dark ? Theme.hover-border : Theme.border-soft;
    Icon {
        commands: root.icon;
        size: 14px;
        tint: ta.has-hover ? Theme.s200 : Theme.s300;
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Botón pequeño con un carácter (− / +) de los editores de hora.
export component StepGlyph inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.o600 : Theme.o700;
    border-width: 1px;
    border-color: Theme.border-soft;
    Text {
        text: root.text;
        font-size: 14px;
        color: Theme.s300;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Interruptor de 48×28: acento encendido, obsidiana apagado.
export component CareSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 48px;
    height: 28px;
    border-radius: 14px;
    background: checked ? Theme.e500 : Theme.o600;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: 150ms; }
    knob := Rectangle {
        x: root.checked ? 24px : 4px;
        y: 4px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? #ffffff : Theme.s400;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;
        animate x, background { duration: 150ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}

// Etiqueta pequeña con borde («Activo», la resolución…).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.s300;
    in property <color> fill: Theme.border-faint;
    in property <color> line: Theme.border-faint;
    in property <bool> mono: false;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 6px;
    background: fill;
    border-width: 1px;
    border-color: line;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 500;
            font-family: root.mono ? Theme.mono : "Inter";
            color: root.ink;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// Selector en forma de pastilla.
export component CareChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 30px;
    horizontal-stretch: 0;
    border-radius: 10px;
    background: selected ? Theme.tint : ta.has-hover ? Theme.o700 : Theme.o700.with-alpha(0.6);
    border-width: 1px;
    border-color: selected ? Theme.tint-border : ta.has-hover ? Theme.hover-border : Theme.border-soft;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.selected ? Theme.e450 : Theme.s200;
            vertical-alignment: center;
        }
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Barra con degradado: la propia pista anticipa el efecto.
// Pista de 10 px; botón blanco con borde oscuro y un anillo que se ilumina
// al pasar el ratón y al arrastrar.
export component GradientSlider {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> value;
    in property <brush> gradient;
    callback changed(float);
    callback released();
    height: 24px;
    property <length> pad: 10px;
    property <float> fraction: max(0, min(1, (value - minimum) / max(0.0001, maximum - minimum)));
    property <length> cx: pad + fraction * (root.width - 2 * pad);

    pure function value-at(x: length) -> float {
        return minimum + max(0, min(1, (x - pad) / max(1px, root.width - 2 * pad))) * (maximum - minimum);
    }

    Rectangle {
        y: (root.height - 10px) / 2;
        height: 10px;
        border-radius: 5px;
        background: Theme.o600;
    }
    Rectangle {
        y: (root.height - 10px) / 2;
        height: 10px;
        border-radius: 5px;
        background: root.gradient;
    }
    // Botón redondo como en el rediseño HTML: blanco con borde de 2,5 px (oscuro
    // en modo oscuro, del color de acento en modo claro), un anillo tenue y una
    // sombra. Al pasar el ratón crece un 13 % y el anillo se vuelve un halo de
    // color; al arrastrar se queda en un 6 %.
    property <float> grow: ta.pressed ? 1.06 : ta.has-hover ? 1.13 : 1.0;
    property <length> knob: 20px * root.grow;
    property <length> halo: ta.has-hover || ta.pressed ? 4px : 2px;
    animate grow { duration: 150ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    Rectangle {
        x: root.cx - root.knob / 2 - root.halo;
        y: root.height / 2 - root.knob / 2 - root.halo;
        width: root.knob + root.halo * 2;
        height: self.width;
        border-radius: self.width / 2;
        background: ta.has-hover || ta.pressed
            ? Theme.e450.with-alpha(Theme.dark ? 0.22 : 0.14)
            : Theme.dark ? #ffffff59 : Theme.e450.with-alpha(0.18);
        animate background { duration: 150ms; }
    }
    Rectangle {
        x: root.cx - root.knob / 2;
        y: root.height / 2 - root.knob / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: #ffffff;
        border-width: 2.5px;
        border-color: Theme.dark ? #0B0F13 : Theme.e450;
        drop-shadow-blur: Theme.dark ? 10px : 8px;
        drop-shadow-offset-y: Theme.dark ? 4px : 2px;
        drop-shadow-color: Theme.dark ? #00000099 : #0F172A38;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.changed(root.value-at(self.mouse-x));
            } else if ev.kind == PointerEventKind.up {
                root.released();
            }
        }
        moved => {
            if self.pressed {
                root.changed(root.value-at(self.mouse-x));
            }
        }
    }
}

// Fila con título, descripción y un interruptor.
export component ToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    border-radius: 12px;
    background: Theme.o850;
    border-width: 1px;
    border-color: Theme.border-faint;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 500;
                color: Theme.s200;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.s400;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            CareSwitch {
                checked: root.checked;
                enabled: root.enabled;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

// Etiqueta, − valor +.
export component Stepper {
    in property <string> label;
    in property <string> subtitle;
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> suffix;
    callback changed(int);
    HorizontalLayout {
        spacing: 4px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.label;
                font-size: 13px;
                color: Theme.s200;
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 11px;
                color: Theme.s400;
                wrap: word-wrap;
            }
        }
        StepGlyph {
            y: (parent.height - self.height) / 2;
            text: "−";
            clicked => { root.changed(max(root.minimum, root.value - root.step)); }
        }
        Text {
            min-width: 64px;
            text: root.value + root.suffix;
            font-size: 13px;
            font-weight: 500;
            font-family: Theme.mono;
            color: Theme.s200;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        StepGlyph {
            y: (parent.height - self.height) / 2;
            text: "+";
            clicked => { root.changed(min(root.maximum, root.value + root.step)); }
        }
    }
}

// Tarjeta de aviso.
export component InfoCard inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <bool> error: false;
    border-radius: Theme.card-radius;
    background: error ? Theme.error.with-alpha(0.12) : Theme.o800;
    border-width: 1px;
    border-color: error ? Theme.error.with-alpha(0.35) : Theme.border-soft;
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 600;
            color: Theme.s200;
            wrap: word-wrap;
        }
        Text {
            text: root.body;
            font-size: 12px;
            color: Theme.s400;
            wrap: word-wrap;
        }
    }
}

// Tarjeta con título y subtítulo.
export component SectionCard inherits CareCard {
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: Theme.s200;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.s400;
            wrap: word-wrap;
        }
    }
    @children
}

// Cabecera de página: icono, título y descripción.
export component PageHeader {
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        IconBox {
            icon: root.icon;
            size: 40px;
            fill: Theme.tint;
            line: Theme.tint-border;
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.s200;
            }
            Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.s400;
            }
        }
    }
}

// Lista desplegable sencilla: muestra la opción elegida y abre un menú.
export component TextMenu inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> menu-width: 260px;
    callback picked(int);
    height: 34px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.o750 : Theme.o700.with-alpha(0.7);
    border-width: 1px;
    border-color: ta.has-hover ? Theme.hover-border : Theme.border-soft;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : "";
            font-size: 12px;
            font-weight: 500;
            color: Theme.s200;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            commands: Icons.expand-more;
            size: 16px;
            tint: Theme.s400;
        }
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, root.menu-width);
        Rectangle {
            background: Theme.menu;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-mid;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.popup-shadow;
            VerticalLayout {
                padding: 4px;
                for opt[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 8px;
                    background: i == root.current && !Theme.dark ? Theme.tint : ita.has-hover ? Theme.menu-hover : transparent;
                    border-width: 1px;
                    border-color: i == root.current && !Theme.dark ? Theme.tint-border : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: opt;
                            font-size: 12px;
                            font-weight: i == root.current ? 600 : 400;
                            color: i == root.current ? Theme.s200 : Theme.s300;
                            vertical-alignment: center;
                        }
                        if i == root.current: Icon {
                            y: (parent.height - self.height) / 2;
                            commands: Icons.check;
                            size: 16px;
                            tint: Theme.e450;
                        }
                    }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.picked(i);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}
