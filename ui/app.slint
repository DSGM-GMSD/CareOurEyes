// Ventana principal y menú de la bandeja. Clon de App.kt / TrayMenu.kt.

import "fonts/Inter-Regular.otf";
import "fonts/Inter-Medium.otf";
import "fonts/Inter-SemiBold.otf";
import "fonts/Inter-Bold.otf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

import { Theme, T } from "theme.slint";
import { Icons } from "icons.slint";
import { App, MonitorItem } from "state.slint";
import { Icon, EyeMark } from "widgets.slint";
import { ScreenPage } from "screen.slint";
import { OptionsPage, AboutPage, PendingPage } from "pages.slint";
import { ScheduleDialog, ResetDialog } from "dialog.slint";
import { Rest, RestPage, BreakToast, BreakOverlay } from "rest.slint";
import { Keys, HotkeyRow } from "keys.slint";
import { Focus, FocusPage, PrismaPage, PrismaBar } from "focus.slint";

export { Theme, T, App, MonitorItem, Rest, BreakToast, BreakOverlay, Keys, HotkeyRow, Focus, PrismaBar }

// ---------------------------------------------------------------- barra de título

// Minimizar o cerrar, como en Windows 11 (el cierre se pone rojo).
component CaptionButton inherits Rectangle {
    in property <bool> close;
    callback clicked;
    width: 40px;
    height: 28px;
    border-radius: 8px;
    background: ta.has-hover ? (close ? Theme.rose500.with-alpha(0.8) : Theme.dark ? #ffffff0f : #0F172A0A) : transparent;
    animate background { duration: 120ms; }
    Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: root.close ? "M1 1 L11 11 M11 1 L1 11" : "M1 6 L11 6";
        // Minimizar en modo claro: trazo oscuro (blanco se perdía sobre el fondo claro).
        stroke: ta.has-hover ? (root.close || Theme.dark ? #ffffff : Theme.s200) : Theme.s400;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        fill: transparent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => {
            if App.debug {
                App.debug-pointer(self.has-hover ? "hover-boton-on" : "hover-boton-off", self.mouse-x, self.mouse-y);
            }
        }
    }
}

component TitleBar inherits Rectangle {
    height: Theme.title-bar + 1px;
    background: Theme.o950;
    // Windows arrastra la ventana desde esta franja (ver enable_title_drag);
    // en Linux la arrastra el gestor de ventanas al pulsar aquí.
    TouchArea {
        height: Theme.title-bar;
        y: 0;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                App.start-drag();
            }
        }
    }
    HorizontalLayout {
        height: Theme.title-bar;
        y: 0;
        padding-left: 16px;
        padding-right: 8px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            CaptionButton {
                close: false;
                clicked => { App.minimize(); }
            }
        }
        VerticalLayout {
            alignment: center;
            CaptionButton {
                close: true;
                clicked => { App.close(); }
            }
        }
    }
    Rectangle {
        y: Theme.title-bar;
        height: 1px;
        background: Theme.border-soft;
    }
}

// ---------------------------------------------------------------- barra lateral

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> hint;
    in property <bool> selected;
    callback clicked;
    border-radius: 12px;
    background: selected ? @linear-gradient(90deg, Theme.e450.with-alpha(0.14) 0%, Theme.e450.with-alpha(0.04) 100%)
        : ta.has-hover && Theme.dark ? Theme.ink.with-alpha(0.03) : transparent;
    border-width: 1px;
    border-color: selected ? Theme.e450.with-alpha(0.38) : ta.has-hover && !Theme.dark ? #E2E8F0 : transparent;
    if root.selected: Rectangle {
        x: 0;
        y: (root.height - 24px) / 2;
        width: 3px;
        height: 24px;
        border-top-right-radius: 2px;
        border-bottom-right-radius: 2px;
        background: Theme.e450;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            // Claro: gris pizarra del HTML (#F1F5F9 con borde #E2E8F0), sin oscurecer al pasar el ratón.
            background: root.selected ? Theme.e500.with-alpha(0.15)
                : !Theme.dark ? #F1F5F9
                : ta.has-hover ? Theme.ink.with-alpha(0.07) : Theme.ink.with-alpha(0.04);
            border-width: !Theme.dark && !root.selected ? 1px : 0px;
            border-color: #E2E8F0;
            Icon {
                commands: root.icon;
                size: 16px;
                tint: root.selected ? Theme.e450 : ta.has-hover ? Theme.s200 : Theme.s400;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 600;
                color: root.selected ? Theme.e450 : ta.has-hover ? Theme.s200 : Theme.s300;
                overflow: elide;
            }
            Text {
                text: root.hint;
                font-size: 11px;
                color: root.selected || ta.has-hover ? Theme.s400 : Theme.s500;
                overflow: elide;
            }
        }
    }
    // Velo al pasar el ratón / pulsar (como el efecto de Compose en la versión Kotlin).
    Rectangle {
        border-radius: root.border-radius;
        // En modo claro, como en el HTML, solo aparece el borde (sin velo).
        background: ta.pressed ? Theme.press : ta.has-hover && Theme.dark ? Theme.hover : transparent;
        animate background { duration: 120ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Confort visual estimado (mismo cálculo que la versión Kotlin).
component ComfortCard inherits Rectangle {
    vertical-stretch: 0;
    property <int> score: max(25, min(100, Math.round(((6500 - App.live-kelvin) / 4700) * 55 + ((100 - App.live-brightness) / 85) * 45 + 32)));
    border-radius: 12px;
    background: Theme.o800.with-alpha(0.8);
    border-width: 1px;
    border-color: Theme.border-faint;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: T.tr("confort_visual");
                font-size: 11px;
                color: Theme.s400;
            }
            Text {
                text: root.score >= 65 ? T.tr("optima") : root.score >= 45 ? T.tr("moderada") : T.tr("alta_luz_azul");
                font-size: 11px;
                font-weight: 600;
                color: root.score >= 65 ? Theme.e450 : root.score >= 45 ? Theme.amber300 : Theme.orange400;
            }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.o950;
            Rectangle {
                x: 0;
                width: parent.width * root.score / 100;
                border-radius: 3px;
                background: @linear-gradient(90deg, Theme.e500 0%, #5EEAD4 100%);
                animate width { duration: 300ms; }
            }
        }
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: T.tr("proxima_pausa");
                font-size: 10px;
                font-family: Theme.mono;
                color: Theme.s500;
            }
            Text {
                text: Rest.enabled && !Rest.paused ? Rest.countdown : "--:--";
                font-size: 10px;
                font-family: Theme.mono;
                color: Theme.s300;
            }
        }
    }
}

component Sidebar inherits Rectangle {
    width: Theme.sidebar;
    background: Theme.o850;
    VerticalLayout {
        padding: 14px;
        // Marca
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            EyeMark { size: 36px; }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "CareOurEyes";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.s200;
                }
                Text {
                    text: App.active ? T.tr("proteccion_activa") : T.tr("sin_control_de_pantalla");
                    font-size: 11px;
                    font-weight: 500;
                    color: App.active ? Theme.e450 : Theme.amber300;
                }
            }
        }
        Rectangle { height: 6px; }
        VerticalLayout {
            spacing: 6px;
            NavItem {
                icon: Icons.desktop-windows;
                label: T.tr("pantalla");
                hint: T.tr("brillo_y_color");
                selected: App.page == 0;
                clicked => { App.page = 0; }
            }
            NavItem {
                icon: Icons.timer;
                label: T.tr("nav_pausa");
                hint: T.tr("recordatorio");
                selected: App.page == 1;
                clicked => { App.page = 1; }
            }
            NavItem {
                icon: Icons.filter-center-focus;
                label: T.tr("enfoque");
                hint: T.tr("franja_y_fondo");
                selected: App.page == 2;
                clicked => { App.page = 2; }
            }
            NavItem {
                icon: Icons.visibility;
                label: T.tr("prisma");
                hint: T.tr("oscuro_o_gris");
                selected: App.page == 3;
                clicked => { App.page = 3; }
            }
            NavItem {
                icon: Icons.settings;
                label: T.tr("opciones");
                hint: T.tr("ajustes");
                selected: App.page == 4;
                clicked => { App.page = 4; }
            }
            NavItem {
                icon: Icons.info;
                label: T.tr("acerca_de");
                hint: T.tr("licencia_e_info");
                selected: App.page == 5;
                clicked => { App.page = 5; }
            }
        }
        Rectangle { vertical-stretch: 1; }
        ComfortCard { }
    }
}

// ---------------------------------------------------------------- ventana

export component AppWindow inherits Window {
    title: "CareOurEyes";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    width: 980px;
    height: 700px;
    // Fuera de Windows (que redondea las esquinas por su cuenta) la ventana es
    // transparente y el marco redondeado lo dibuja la propia app.
    background: App.rounded-window ? transparent : Theme.o900;
    default-font-family: "Inter";
    default-font-size: 13px;

    frame := Rectangle {
        border-radius: App.rounded-window ? 10px : 0px;
        border-width: App.rounded-window ? 1px : 0px;
        border-color: Theme.border-mid;
        background: Theme.o900;
        clip: true;

        // Solo en diagnóstico: detrás de todo, anota los eventos del ratón que no
        // atrapa ningún otro elemento.
        if App.debug: TouchArea {
            pointer-event(ev) => {
                App.debug-pointer(ev.kind == PointerEventKind.move ? "move" : ev.kind == PointerEventKind.down ? "down" : ev.kind == PointerEventKind.up ? "up" : "cancel", self.mouse-x, self.mouse-y);
            }
        }

        VerticalLayout {
            TitleBar { }
            HorizontalLayout {
                vertical-stretch: 1;
                Sidebar { }
                Rectangle {
                    width: 1px;
                    background: Theme.border-soft;
                }
                content := Flickable {
                    horizontal-stretch: 1;
                    content-height: max(self.height, page.preferred-height + 2 * Theme.page-pad);
                    page := VerticalLayout {
                        x: Theme.page-pad;
                        y: Theme.page-pad;
                        width: content.width - 2 * Theme.page-pad;
                        height: self.preferred-height;
                        spacing: Theme.gap;
                        if App.page == 0: ScreenPage { }
                        if App.page == 1: RestPage { }
                        if App.page == 2: FocusPage { }
                        if App.page == 3: PrismaPage { }
                        if App.page == 4: OptionsPage { }
                        if App.page == 5: AboutPage { }
                    }
                }
            }
        }

        if App.confirm-reset: ResetDialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
        }

        if App.dialog-open: ScheduleDialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
        }
    }
}

// ---------------------------------------------------------------- menú de la bandeja

component TrayMenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> accent;
    callback clicked;
    height: 34px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.o700 : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            commands: root.icon;
            size: 16px;
            tint: root.accent || ta.has-hover ? Theme.e400 : Theme.s400;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            font-size: 13px;
            color: root.accent ? Theme.e400 : Theme.s200;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TrayMenu inherits Window {
    in property <bool> paused;
    in property <string> resume-label;
    callback show-window();
    callback toggle-pause();
    callback quit();
    title: "CareOurEyes";
    no-frame: true;
    always-on-top: true;
    // Windows 11 le pone esquinas redondeadas, borde y sombra (DWM).
    width: 240px;
    height: 134px;
    background: Theme.o800;
    default-font-family: "Inter";

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-soft;
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            TrayMenuItem {
                icon: Icons.desktop-windows;
                label: T.tr("mostrar_ventana");
                clicked => { root.show-window(); }
            }
            TrayMenuItem {
                icon: root.paused ? Icons.play-circle : Icons.pause-circle;
                label: root.paused ? T.tr1("reanudar_filtro", root.resume-label) : T.tr("pausar_filtro");
                accent: root.paused;
                clicked => { root.toggle-pause(); }
            }
            Rectangle {
                height: 9px;
                Rectangle {
                    x: 6px;
                    width: parent.width - 12px;
                    height: 1px;
                    background: Theme.border-soft;
                }
            }
            TrayMenuItem {
                icon: Icons.power-settings-new;
                label: T.tr("salir");
                clicked => { root.quit(); }
            }
        }
    }
}
